{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CW-122A normalized campaign dataset",
  "type": "object",
  "required": [
    "schema",
    "scope",
    "runs"
  ],
  "properties": {
    "schema": {
      "const": "cw122a-runs-v1"
    },
    "scope": {
      "enum": [
        "SYNTHETIC_REHEARSAL",
        "LIVE_PROVIDER"
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "usage_provenance",
        "raw_usage",
        "first_byte_latency_ms",
        "first_byte_provenance"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "usage_provenance": {
          "enum": [
            "synthetic_mock_usage",
            "provider_response_usage"
          ]
        },
        "raw_usage": {
          "type": "object"
        },
        "first_byte_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "first_byte_provenance": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "pair_id",
        "family",
        "task_id",
        "repetition",
        "mode",
        "order",
        "session_id",
        "attempt_id",
        "status",
        "failure_reason",
        "repository_hash",
        "initial_fixture_hashes",
        "configuration_hash",
        "runtime",
        "sampling",
        "requests",
        "duration_ms",
        "duration_provenance",
        "acceptance",
        "wire"
      ],
      "properties": {
        "mode": {
          "enum": [
            "M1",
            "M2"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "aborted",
            "invalid"
          ]
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          }
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "runtime": {
          "type": "object",
          "required": [
            "provider",
            "model",
            "agent_version",
            "model_revision",
            "server_version"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "agent_version": {
              "type": "string",
              "minLength": 1
            },
            "model_revision": {
              "type": "string",
              "minLength": 1
            },
            "server_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "wire": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "session_id",
            "mode",
            "original",
            "outbound",
            "applied_mutation_ids",
            "skipped_mutations",
            "estimated_pruned_tokens",
            "estimated_kv_break_tokens",
            "treatment_verified",
            "request_count"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "mode": {
              "enum": [
                "M1",
                "M2"
              ]
            },
            "original": {
              "type": "object"
            },
            "outbound": {
              "type": "object"
            },
            "applied_mutation_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "skipped_mutations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rule_id",
                  "reason"
                ],
                "properties": {
                  "rule_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "estimated_pruned_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "estimated_kv_break_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "treatment_verified": {
              "type": "boolean"
            },
            "request_count": {
              "type": "integer",
              "minimum": 1
            },
            "pair_id": {
              "type": "string",
              "minLength": 1
            },
            "family": {
              "enum": [
                "f1",
                "f2"
              ]
            },
            "candidate_decision": {
              "type": "string",
              "minLength": 1
            },
            "decision_provenance": {
              "type": "string",
              "minLength": 1
            },
            "evidence_scope": {
              "type": "string",
              "minLength": 1
            },
            "mock_response": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "acceptance": {
          "type": "object",
          "required": [
            "passed",
            "functional_passed",
            "constraint_violations"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "functional_passed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "constraint_violations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exit_code": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "pair_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "duration_provenance": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "f1",
            "f2"
          ]
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "order": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "initial_fixture_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "sampling": {
          "type": "object",
          "required": [
            "temperature",
            "top_p",
            "seed",
            "nondeterminism"
          ],
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0
            },
            "top_p": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            },
            "nondeterminism": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "wire": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
